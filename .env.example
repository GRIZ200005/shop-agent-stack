# Run ./scripts/init-local.ps1 to create an ignored .env with random values.
SHOP_AGENT_STACK_DB_PASSWORD=replace-with-random-value
SHOP_AGENT_STACK_DB_ROOT_PASSWORD=replace-with-random-value
SHOP_AGENT_STACK_MQ_PASSWORD=replace-with-random-value
SHOP_AGENT_STACK_PORTAL_JWT_SECRET=replace-with-at-least-64-random-characters
SHOP_AGENT_STACK_ADMIN_JWT_SECRET=replace-with-at-least-64-random-characters
SHOP_AGENT_STACK_BOOTSTRAP_ADMIN_PASSWORD=replace_with_random_local_value
SHOP_AGENT_STACK_BOOTSTRAP_SERVICE_PASSWORD=replace_with_random_local_value

# P2: configure any subset; use model identifiers enabled for your account.
# Platform secrets belong in ignored local .env; personal connections use the encrypted account settings UI.
SHOP_AGENT_STACK_DEEPSEEK_API_KEY=
SHOP_AGENT_STACK_DEEPSEEK_MODEL=
SHOP_AGENT_STACK_DEEPSEEK_BASE_URL=https://api.deepseek.com
SHOP_AGENT_STACK_OPENAI_API_KEY=
SHOP_AGENT_STACK_OPENAI_MODEL=
SHOP_AGENT_STACK_OPENAI_BASE_URL=https://api.openai.com/v1
SHOP_AGENT_STACK_KIMI_API_KEY=
SHOP_AGENT_STACK_KIMI_MODEL=
SHOP_AGENT_STACK_KIMI_BASE_URL=https://api.moonshot.cn/v1
# Custom endpoint must support Chat Completions + function tools over HTTPS.
SHOP_AGENT_STACK_CUSTOM_API_KEY=
SHOP_AGENT_STACK_CUSTOM_MODEL=
SHOP_AGENT_STACK_CUSTOM_BASE_URL=
