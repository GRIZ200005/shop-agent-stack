# Run ./scripts/init-local.ps1 to create an ignored .env with random values.
ASTER_DB_PASSWORD=replace-with-random-value
ASTER_DB_ROOT_PASSWORD=replace-with-random-value
ASTER_MQ_PASSWORD=replace-with-random-value
ASTER_PORTAL_JWT_SECRET=replace-with-at-least-64-random-characters
ASTER_ADMIN_JWT_SECRET=replace-with-at-least-64-random-characters
ASTER_BOOTSTRAP_ADMIN_PASSWORD=replace_with_random_local_value
ASTER_BOOTSTRAP_SERVICE_PASSWORD=replace_with_random_local_value

# P2: configure any subset; use model identifiers enabled for your account.
# Platform secrets belong in ignored local .env; personal connections use the encrypted account settings UI.
ASTER_DEEPSEEK_API_KEY=
ASTER_DEEPSEEK_MODEL=
ASTER_DEEPSEEK_BASE_URL=https://api.deepseek.com
ASTER_OPENAI_API_KEY=
ASTER_OPENAI_MODEL=
ASTER_OPENAI_BASE_URL=https://api.openai.com/v1
ASTER_KIMI_API_KEY=
ASTER_KIMI_MODEL=
ASTER_KIMI_BASE_URL=https://api.moonshot.cn/v1
# Custom endpoint must support Chat Completions + function tools over HTTPS.
ASTER_CUSTOM_API_KEY=
ASTER_CUSTOM_MODEL=
ASTER_CUSTOM_BASE_URL=
